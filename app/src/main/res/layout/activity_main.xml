<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edge Voice Assistant"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/modeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Idle"
            android:textColor="#03DAC5"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap 'Start Assistant' to begin."
            android:textColor="#E0E0E0"
            android:textSize="15sp"
            android:gravity="center"
            android:minLines="3"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/toggleListenButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Start Assistant"
            android:textSize="15sp"
            android:textColor="#000000"
            android:backgroundTint="#03DAC5"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/wakeWordButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⚡ Configure Wake Word"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#018786"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/guideButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="📖 Commands &amp; Features Guide"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3700B3"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/remapButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⚙️ Remap Command Actions"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2C2C2C"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Active Bindings:"
            android:textColor="#888888"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/mappingSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#BB86FC"
            android:textSize="13sp"
            android:lineSpacingExtra="6dp" />

    </LinearLayout>
</ScrollView>
